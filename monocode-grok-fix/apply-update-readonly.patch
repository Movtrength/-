diff --git a/src/app/model/updaterInstall.test.ts b/src/app/model/updaterInstall.test.ts
new file mode 100644
index 0000000..ab4f2f4
--- /dev/null
+++ b/src/app/model/updaterInstall.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+import {
+  READONLY_INSTALL_HELP,
+  explainUpdateInstallError,
+  installLocationKind,
+  isReadOnlyInstallError,
+  isReadOnlyInstallLocation,
+} from "./updaterInstall";
+
+describe("updater install location", () => {
+  it("treats disk images and App Translocation as read-only", () => {
+    expect(installLocationKind("/Volumes/MonoCode/MonoCode.app")).toBe(
+      "volumes",
+    );
+    expect(
+      installLocationKind(
+        "/private/var/folders/xx/AppTranslocation/A/d/MonoCode.app",
+      ),
+    ).toBe("translocated");
+    expect(
+      isReadOnlyInstallLocation("/Volumes/MonoCode/MonoCode.app/Contents"),
+    ).toBe(true);
+    expect(
+      isReadOnlyInstallLocation(
+        "/private/var/folders/xx/AppTranslocation/A/d/MonoCode.app",
+      ),
+    ).toBe(true);
+    expect(
+      isReadOnlyInstallLocation("/Applications/MonoCode.app/Contents/Resources"),
+    ).toBe(false);
+  });
+
+  it("rewrites os error 30 into a move-to-Applications message", () => {
+    expect(isReadOnlyInstallError(new Error("Read-only file system (os error 30)"))).toBe(
+      true,
+    );
+    expect(
+      explainUpdateInstallError("Read-only file system (os error 30)"),
+    ).toBe(READONLY_INSTALL_HELP);
+    expect(
+      explainUpdateInstallError("install failed", "/Volumes/MonoCode/MonoCode.app"),
+    ).toBe(READONLY_INSTALL_HELP);
+    expect(explainUpdateInstallError("network failed")).toBe("network failed");
+  });
+});
diff --git a/src/app/model/updaterInstall.ts b/src/app/model/updaterInstall.ts
new file mode 100644
index 0000000..a6f3b8c
--- /dev/null
+++ b/src/app/model/updaterInstall.ts
@@ -0,0 +1,44 @@
+export const READONLY_INSTALL_HELP =
+  "MonoCode is running from a read-only copy (a disk image, Downloads quarantine, or App Translocation). The updater cannot replace that file.\n\n1. Quit MonoCode\n2. Drag MonoCode.app into the Applications folder\n3. Eject the disk image if it is still mounted\n4. Open MonoCode from Applications, then update again.";
+
+export type InstallLocationKind =
+  | "volumes"
+  | "translocated"
+  | "downloads"
+  | "applications"
+  | "other";
+
+/** Classify the running bundle so the updater can refuse a known-unwritable copy. */
+export function installLocationKind(path: string): InstallLocationKind {
+  const normalized = path.replace(/\\/g, "/").toLowerCase();
+  if (normalized.includes("/apptranslocation/")) return "translocated";
+  if (/(^|\/)volumes\//.test(normalized)) return "volumes";
+  if (normalized.includes("/downloads/")) return "downloads";
+  if (normalized.includes("/applications/")) return "applications";
+  return "other";
+}
+
+export function isReadOnlyInstallLocation(path: string): boolean {
+  const kind = installLocationKind(path);
+  return kind === "volumes" || kind === "translocated";
+}
+
+export function isReadOnlyInstallError(error: unknown): boolean {
+  const text = error instanceof Error ? error.message : String(error ?? "");
+  return /read-only file system|os error 30|erofs|readonly filesystem/i.test(
+    text,
+  );
+}
+
+export function explainUpdateInstallError(
+  error: unknown,
+  installPath?: string,
+): string {
+  if (
+    (installPath && isReadOnlyInstallLocation(installPath)) ||
+    isReadOnlyInstallError(error)
+  ) {
+    return READONLY_INSTALL_HELP;
+  }
+  return error instanceof Error ? error.message : String(error);
+}
