+export function grokSessionNewFallbackParams(
+  cwd: string,
+): Record<string, unknown> {
+  return { cwd, mcpServers: [] };
+}
+
+/**
+ * MonoCode's empty-project sentinel is "~". Grok ACP `session/new` requires an
+ * absolute cwd, so passing "~" comes back as JSON-RPC -32602 Invalid params.
+ */
+export function resolveGrokWorkspaceCwd(cwd: string, home: string): string {
+  const trimmed = cwd.trim();
+  const root = home.replace(/[\\/]+$/, "");
+  if (!trimmed || trimmed === "~") return root;
+  if (trimmed === "~/" || trimmed.startsWith("~/")) {
+    const rest = trimmed.slice(2).replace(/[\\/]+$/, "");
+    return rest ? `${root}/${rest}` : root;
+  }
+  return trimmed;
+}
+
+export function isAbsoluteWorkspaceCwd(cwd: string): boolean {
+  const value = cwd.trim();
+  return (
+    value.startsWith("/") ||
+    /^[A-Za-z]:[\\/]/.test(value) ||
+    value.startsWith("\\\\")
+  );
+}
+
+export function grokMissingProjectMessage(cwd: string): string {
+  return `Grok Build did not start. Invalid params.\n\nOpen a project folder first. Grok ACP session/new needs an absolute working directory, not "${cwd || "~"}".`;
+}
+
+export function assertGrokWorkspaceCwd(cwd: string, home: string): string {
+  const resolved = resolveGrokWorkspaceCwd(cwd, home);
+  if (!isAbsoluteWorkspaceCwd(resolved)) {
+    throw new Error(grokMissingProjectMessage(cwd));
+  }
+  return resolved;
+}
+
+/**
+ * `grok-build` is the CLI product name, not a live ACP model id. Map it onto
+ * the current session model (`grok-4.6` / `grok-4.5`) before `session/set_model`.
+ */
+export function resolveGrokAcpModelId(
+  requested: string,
+  available: string[] = [],
+  current?: string,
+): string {
+  const native = nativeId(requested);
+  const catalog = available.filter(Boolean);
+  const pickCurrent =
+    current && catalog.includes(current) ? current : (catalog[0] ?? current ?? "");
+  if (!native || GROK_PRODUCT_MODEL_IDS.has(native)) return pickCurrent;
+  if (catalog.length === 0 || catalog.includes(native)) return native;
+  return pickCurrent;
+}
+
+export function isInvalidParamsError(error: unknown): boolean {
+  const detail = error instanceof Error ? error.message : String(error ?? "");
+  return /invalid params|unknown model id|-32602/i.test(detail);
+}
+
+export function shouldRetrySessionNewWithoutMeta(
+  error: unknown,
+  params: Record<string, unknown>,
+): boolean {
+  return isInvalidParamsError(error) && params._meta != null;
+}
