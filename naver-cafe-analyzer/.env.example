# Stagehand uses this for extract() / act() on cafe pages.
# Stagehand does not read env vars itself — the CLI passes them in.
MODEL_API_KEY=sk-...
MODEL_NAME=openai/gpt-4.1-mini

# Optional: cloud browser instead of local Chrome.
# BROWSERBASE_API_KEY=

# Optional: persist a Naver login you complete yourself in a headed browser.
# USER_DATA_DIR=./browser-data
